{
  "config": {
    "step": {
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]",
      "unsupported_device": "Unsupported device"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]"
    }
  },
  "entity": {
    "climate": {
      "s21climate": {
        "state_attributes": {
          "fan_mode": {
            "state": {
              "custom": "Custom"
            }
          }
        }
      }
    },
    "button": {
      "blauberg_s21_reset_filter": { "name": "Reset filter timer" },
      "blauberg_s21_reset_alarm":  { "name": "Reset alarm" }
    },
    "switch": {
      "blauberg_s21_boost_switch": { "name": "Boost Mode-Switch" },
      "blauberg_s21_timer_switch": { "name": "Timer Mode-Switch" },
      "blauberg_s21_schedule_mode_switch": { "name": "Schedule Mode-Switch" }
    },
    "select": {
      "blauberg_s21_bypass_mode": {
        "name": "Bypass mode",
        "state": {
          "close": "Close bypass / Start rotor",
          "open": "Open bypass / Stop rotor",
          "auto": "Automatic"
        }
      }
    },
    "sensor": {
      "intake_temperature_in": { "name": "Intake temperature in" },
      "intake_temperature_out": { "name": "Intake temperature out" },
      "outlet_temperature_in": { "name": "Outlet temperature in" },
      "outlet_temperature_out": { "name": "Outlet temperature out" },
      "incoming_air_pressure": { "name": "Incoming air pressure" },
      "outgoing_air_pressure": { "name": "Outgoing air pressure" }
    },
    "binary_sensor": {
      "connection": { "name": "Connection" },
      "alarm": { "name": "Alarm" },
      "filter_warning": { "name": "Filter warning" }
    }
  },
  "services": {
    "reset_filter_change_timer": {
      "name": "Reset timer for filter change",
      "description": "Resets the countdown timer for filter replacement."
    },
    "reset_alarm": {
      "name": "Reset alarm",
      "description": "Resets the current alarm state."
    }
